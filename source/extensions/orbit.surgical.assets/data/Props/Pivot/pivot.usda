#usda 1.0
(
    defaultPrim = "Pivot"
    metersPerUnit = 1
    upAxis = "Z"
)


def Xform "Pivot" (
    apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:rigidBodyEnabled = 1
    bool physics:kinematicEnabled = 1
    float physics:mass = 0.001

    def Sphere "Visual" (
        apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    ) {
        float radius = 0.01
    }
}